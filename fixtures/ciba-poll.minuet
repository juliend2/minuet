actors C=client, A=authz, U=user

flow ciba+poll {
  given C: client_id, client_secret, login_hint, binding_message?
  C: auth = basic(client_id, client_secret)

  C => A POST /bc-authorize @{ Authorization=auth } ${
    scope="openid", login_hint, binding_message?, requested_expiry?
  } {
    <- 200 { auth_req_id, expires_in, interval? }
    <- 400 { error=invalid_request | unknown_user_id | invalid_binding_message } do fail
  }
  C: interval = default(interval, 5s)

  par {
    A <..> U : notify(binding_message), authn, consent
  } and {
    loop within expires_in {
      C: wait interval
      C => A POST /token @{ Authorization=auth } ${
        grant_type="urn:openid:params:grant-type:ciba", auth_req_id
      } {
        <- 200 { access_token, id_token, refresh_token?, expires_in }   do break
        <- 400 { error=authorization_pending }                          do continue
        <- 400 { error=slow_down }          do interval = interval + 5s; continue
        <- 400 { error=access_denied | expired_token }                  do fail
      }
    }
  }
  C: verify(id_token)
}
